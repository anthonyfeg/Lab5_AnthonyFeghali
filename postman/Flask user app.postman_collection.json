  "item": [
    {
      "name": "01 Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/add",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"067765434567\",\n  \"address\": \"John Doe Street, Innsbruck\",\n  \"country\": \"Austria\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "pm.environment.set(\"user_id\", pm.response.json().user_id);",
              "pm.test(\"Generated ID\", () => pm.expect(pm.response.json().user_id).to.be.a(\"number\"));",
              "pm.test(\"Created name\", () => pm.expect(pm.response.json().name).to.eql(\"John Doe\"));"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "201 live response",
          "originalRequest": {
